# Pexels API anahtarı (https://www.pexels.com/api/ adresinden ücretsiz alınabilir)
PEXELS_API_KEY=your_pexels_api_key_here

# Ollama sunucu adresi (yerel LLM için)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama'da kullanılacak model adı
OLLAMA_MODEL=llama3

# edge-tts seslendirme sesi (Türkçe: tr-TR-EmelNeural veya tr-TR-AhmetNeural)
TTS_VOICE=tr-TR-EmelNeural

# Çıktı video çözünürlüğü (dikey format, GENELLIKLE DEGISTIRMEYIN)
OUTPUT_RESOLUTION=1080x1920
